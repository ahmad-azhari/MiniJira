# ==============================================================================
# Mini Jira - Configuración de Entorno
# ==============================================================================
# Copiar este archivo a .env y actualizar los valores según tu entorno
# NUNCA comprometer .env en control de versiones
# ==============================================================================

# Configuración de Flask
# Valores: development, testing, production
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=True

# ==============================================================================
# Base de Datos
# ==============================================================================
# SQLite (desarrollo)
DATABASE_URL=sqlite:///mini_jira.db

# MySQL (producción - descomentar y configurar)
# DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/minijira

# PostgreSQL (producción - descomentar y configurar)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/minijira

# ==============================================================================
# Seguridad
# ==============================================================================
# Cambiar este valor en PRODUCCIÓN - usar una clave segura y aleatoria
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=tu_clave_secreta_super_segura_cambiar_en_produccion

# ==============================================================================
# Configuración de Sesión (opcional)
# ==============================================================================
# SESSION_TYPE=filesystem
# PERMANENT_SESSION_LIFETIME=3600

# ==============================================================================
# Rutas Automáticas
# ==============================================================================
# UPLOAD_FOLDER se configura automáticamente en config/settings.py
# Ubicación: app/subidas/

# ==============================================================================
# Jenkins - Automatización de Pruebas
# ==============================================================================
JENKINS_URL=http://localhost:8080
JENKINS_JOB=Pipeline
JENKINS_USUARIO=usuario_jenkins
JENKINS_TOKEN_API=token_api_jenkins_aqui
JENKINS_TOKEN_CONSTRUCCION=token_construccion_aqui
JENKINS_TIEMPO_ESPERA=30
JENKINS_RUTA_PYTHON=C:\Python314\python.exe

# ==============================================================================
# Proxy Corporativo (Opcional - solo en entorno corporativo)
# ==============================================================================
# Usar si tu empresa intercepta tráfico SSL
# HTTP_PROXY=http://proxy.empresa.com:8080
# HTTPS_PROXY=https://proxy.empresa.com:8080
# NO_PROXY=localhost,127.0.0.1,*.local
